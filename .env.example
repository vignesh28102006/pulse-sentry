# ==============================================================================
# PulseSentry Environment Configuration Template
# Copy this file to .env before starting the platform: cp .env.example .env
# NEVER commit the actual .env file or production secrets to version control.
# ==============================================================================

# ---- Backend Core Configuration
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://pulsesentry:pulsesentry@localhost:5433/pulsesentry
DATABASE_URL_TEST=postgres://pulsesentry:pulsesentry@localhost:5433/pulsesentry_test

# Asynchronous Task Queue (Leave empty to run background tasks inline without Redis)
REDIS_URL=

# Security & Authentication
JWT_SECRET=replace-with-a-secure-random-256-bit-string
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173

# Microservice Endpoints
RISK_ENGINE_URL=http://localhost:8000
RISK_ENGINE_TIMEOUT_MS=3000
SIMULATOR_URL=http://localhost:4100
DASHBOARD_URL=http://localhost:5173

# Clinical Alert & Timing Thresholds
SENSOR_OFFLINE_SECONDS=15
OFFLINE_GRACE_SECONDS=0
ACK_TIMEOUT_SECONDS=60
ALERT_COOLDOWN_SECONDS=60
RAPID_INCREASE_THRESHOLD=20
NOTE_WINDOW_MINUTES=120
WATCHDOG_INTERVAL_MS=5000
LOG_LEVEL=info

# ---- Outbound Phone Notifications (Telegram Bot - Optional)
# 1. Message @BotFather on Telegram -> /newbot -> Paste bot token below.
# 2. Start PulseSentry backend, send /start to your bot -> Bot responds with your chat ID.
# 3. Paste chat ID into TELEGRAM_CHAT_ID and restart backend.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ESCALATION_CHAT_ID=
TELEGRAM_USER_EMAIL=anita@homecare.demo

# ---- IoT Telemetry Authentication (Shared between Gateway and Sensors)
DEVICE_API_KEY=replace-with-cryptographic-device-pre-shared-key
SIMULATOR_CONTROL_TOKEN=replace-with-secure-simulator-token

# ---- Sensor Simulator Configuration
BACKEND_URL=http://localhost:4000
SIMULATOR_PORT=4100
SIMULATOR_TICK_MS=2000
SIMULATOR_BATCH_SIZE=100
SIMULATOR_RETRY_BASE_MS=1000
SIMULATOR_RETRY_MAX_MS=30000
DEMO_START=story

# ---- Local PostgreSQL Embedded Engine (Used by npm run db:start)
LOCAL_PG_PORT=5433
